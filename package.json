{
  "name": "dsh-pdf-translator",
  "version": "0.2.3",
  "description": "AI vision PDF translation and LaTeX reconstruction for DeepSeek Harness",
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src",
    "work/*.py",
    "!work/test_*.py",
    "scripts",
    "cordis.patch.yml",
    "requirements.txt",
    "config.example.json",
    "README.md",
    "NOTICE.md",
    "VERIFICATION.md",
    "lib/client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/manager.js && node --check src/service.js && node --check src/native-picker.js && node --check src/page-selection.js",
    "build": "node scripts/build-client.mjs",
    "test:visual": "node tests/visual-panel.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@testing-library/react": "^16.3.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh-plugin",
    "pdf",
    "translation",
    "vision"
  ],
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
