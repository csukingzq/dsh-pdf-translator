{
  "name": "dsh-pdf-translator",
  "version": "0.4.3",
  "description": "AI vision PDF translation and LaTeX reconstruction for DeepSeek Harness",
  "type": "module",
  "main": "src/index.js",
  "author": "csukingzq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csukingzq/dsh-pdf-translator.git"
  },
  "homepage": "https://github.com/csukingzq/dsh-pdf-translator#readme",
  "bugs": {
    "url": "https://github.com/csukingzq/dsh-pdf-translator/issues"
  },
  "files": [
    "src",
    "work/*.py",
    "!work/test_*.py",
    "scripts",
    "cordis.patch.yml",
    "requirements.txt",
    "config.example.json",
    "README.md",
    "VERIFICATION.md",
    "CHANGELOG.md",
    "LICENSE",
    "lib/client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/manager.js && node --check src/service.js && node --check src/setup.js && node --check src/native-picker.js && node --check src/page-selection.js && node --check src/paths.js",
    "build": "node scripts/build-client.mjs",
    "test:visual": "node tests/visual-panel.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build && npm run check",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-jobs-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.3",
    "@testing-library/react": "^16.3.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5",
    "zod": "^4.0.0"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0",
    "node": ">=22"
  },
  "keywords": [
    "dsh-plugin",
    "pdf",
    "translation",
    "vision",
    "latex",
    "deepseek-harness"
  ],
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
